# Copier en .env.local pour changer de source de données
# api  = données réelles (défaut) : caméra via detect.py, alertes via l'API, capteurs via /ws
#        (rejeu du jeu de données IA tant que l'ESP n'envoie rien)
# mock = simulation hors matériel, avec sélecteur de scénario
VITE_DATA_SOURCE=api
# Vide = même origine (proxy Vite en dev, Caddy en prod)
VITE_API_BASE=
